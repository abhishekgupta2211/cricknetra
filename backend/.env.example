# ─── CricNetra API settings ──────────────────────────────────────────────────
# Copy to "backend/.env" for local (non-Docker) runs. Every key is also settable
# as an environment variable with the CRICNETRA_ prefix (see app/core/config.py).
# When running under docker-compose these are supplied by the compose file.
#
#   cp backend/.env.example backend/.env

# SQLAlchemy URL. Leave empty to use the in-memory store (quick demos / tests).
# Postgres example (psycopg 3 driver):
CRICNETRA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/CricNetra_db

# Auth / JWT. MUST be a long random string in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CRICNETRA_SECRET_KEY=dev-insecure-secret-change-me-in-production
CRICNETRA_ALGORITHM=HS256

# Token lifetimes. Short access token + long, revocable, rotating refresh token.
CRICNETRA_ACCESS_TOKEN_EXPIRE_MINUTES=30
CRICNETRA_REFRESH_TOKEN_EXPIRE_DAYS=30

# Per-IP rate limiting on auth endpoints (login / register / forgot-password).
CRICNETRA_RATE_LIMIT_ENABLED=true

# Account verification + password reset. With no SMS/email provider wired up,
# dev delivery returns the code/token in the API response so the flow is
# testable. Set to false in production once a real sender is connected.
CRICNETRA_AUTH_DEV_DELIVERY=true
CRICNETRA_VERIFY_CODE_TTL_MINUTES=15
CRICNETRA_RESET_TOKEN_TTL_MINUTES=30

# CORS origins for a separate browser frontend (JSON array). The bundled SPA is
# same-origin and needs no entry here.
# CRICNETRA_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging. log_format "console" (human-readable, dev) or "json" (one JSON object
# per line, for log aggregators in production). log_level: DEBUG/INFO/WARNING/...
CRICNETRA_LOG_FORMAT=console
CRICNETRA_LOG_LEVEL=INFO

# Notification delivery (OTP/reset). Leave all unset → a console sender that just
# logs the code (fine for dev with CRICNETRA_AUTH_DEV_DELIVERY=true). For real
# delivery, set Twilio (SMS) and/or SMTP (email) and turn AUTH_DEV_DELIVERY off.
# CRICNETRA_TWILIO_ACCOUNT_SID=ACxxxxxxxx
# CRICNETRA_TWILIO_AUTH_TOKEN=your-token
# CRICNETRA_TWILIO_FROM=+15551234567
# CRICNETRA_SMTP_HOST=smtp.example.com
# CRICNETRA_SMTP_PORT=587
# CRICNETRA_SMTP_USER=apikey
# CRICNETRA_SMTP_PASSWORD=your-password
# CRICNETRA_SMTP_FROM=no-reply@yourdomain.com
# CRICNETRA_SMTP_STARTTLS=true

# Auto-clipped video highlights (ffmpeg). Where uploaded match recordings and the
# generated clips are stored. Default: backend/.data — point this at a real volume
# in production so media survives a redeploy.
# CRICNETRA_MEDIA_DIR=/var/lib/cricnetra/media

# Folder holding BOTH ffmpeg and ffprobe (ffprobe reads the video duration — a
# build with only ffmpeg won't do). Leave unset to auto-discover: PATH → a Windows
# winget install → common spots (C:\ffmpeg\bin, <project>/ffmpeg/bin). Set it when
# ffmpeg lives elsewhere; if it isn't found, the "Auto-clip from a recording" panel
# is simply hidden and clip generation is unavailable. Restart after changing it —
# discovery runs once at import.
#   Windows: CRICNETRA_FFMPEG_DIR=C:/ffmpeg/bin
#   Linux:   CRICNETRA_FFMPEG_DIR=/usr/bin
# CRICNETRA_FFMPEG_DIR=

# Branding — both have sensible defaults; you rarely need these.
# CRICNETRA_APP_NAME=CricNetra API
# CRICNETRA_VERSION=0.1.0
