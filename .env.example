# ─── CricNetra deployment configuration ─────────────────────────────────────
# Copy to ".env" next to docker-compose.yml and fill in your own values:
#
#   cp .env.example .env      # then edit .env
#
# .env is git-ignored — NEVER commit real secrets. These feed the ${...}
# placeholders in docker-compose.yml (and docker-compose.prod.yml).

# ── Database (the `db` service is created with these; the app connects to it) ─
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=CricNetra_db
POSTGRES_PORT=5432
APP_PORT=8000

# ── App secret — the JWT signing key. MUST be a long random string, kept the
#    SAME across restarts/instances (changing it logs everyone out). Generate:
#      python -c "import secrets; print(secrets.token_urlsafe(64))"
CRICNETRA_SECRET_KEY=CHANGE-ME-run-the-python-command-above

# ── Account security. Keep FALSE in production (true only leaks OTP/reset codes
#    in API responses for local dev without a mail provider).
CRICNETRA_AUTH_DEV_DELIVERY=false

# ── Email (OTP + password reset) via SMTP. Example shown for Brevo. Leave
#    CRICNETRA_SMTP_HOST empty to fall back to logging codes to the console.
CRICNETRA_SMTP_HOST=smtp-relay.brevo.com
CRICNETRA_SMTP_PORT=587
CRICNETRA_SMTP_USER=CHANGE-ME-your-brevo-smtp-login
CRICNETRA_SMTP_PASSWORD=CHANGE-ME-your-fresh-brevo-smtp-key
CRICNETRA_SMTP_FROM=CHANGE-ME-your-verified-sender@example.com
CRICNETRA_SMTP_STARTTLS=true

# ── Logging: "json" (structured, for aggregators) or "console" (human-readable).
CRICNETRA_LOG_FORMAT=json
CRICNETRA_LOG_LEVEL=INFO

# ── HTTPS reverse proxy (only used by docker-compose.prod.yml + Caddyfile).
#    DNS A/AAAA for DOMAIN must already point at this server's public IP.
DOMAIN=cricnetra.example.com
LETSENCRYPT_EMAIL=CHANGE-ME-you@example.com
